<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>

<TabPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="at.htlkaindorf._01_inventorymanagement.controller.AppController">
  <tabs>
    <Tab text="RECORD">
         <content>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                      <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label text="CODE" />
                        <Label text="NAME" GridPane.rowIndex="1" />
                        <Label text="TYPE" GridPane.rowIndex="2" />
                        <Label text="AMOUNT" GridPane.rowIndex="3" />
                        <TextField fx:id="tfCode" GridPane.columnIndex="1" />
                        <TextField fx:id="tfName" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <TextField fx:id="tfAmount" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <ChoiceBox fx:id="cbType" prefHeight="31.0" prefWidth="324.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                     </children>
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </GridPane>
                  <ListView fx:id="lvItems" prefHeight="150.0">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </ListView>
                  <HBox alignment="CENTER" spacing="100.0">
                     <children>
                        <Button fx:id="btAddItem" mnemonicParsing="false" text="ADD" />
                        <Button fx:id="btDeleteItem" mnemonicParsing="false" text="DELETE" />
                     </children>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </content></Tab>
    <Tab text="TYPES">
         <content>
            <VBox spacing="10.0">
               <children>
                  <HBox alignment="CENTER" spacing="100.0">
                     <children>
                        <Button fx:id="btAddType" mnemonicParsing="false" text="ADD" />
                        <Button fx:id="btDeleteType" mnemonicParsing="false" text="DELETE" />
                     </children>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </HBox>
                  <ListView fx:id="lvTypes" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </content></Tab>
      <Tab text="SEARCH &amp; EDIT">
         <content>
            <VBox>
               <children>
                  <TextField fx:id="tfSearchText" promptText="Search Text" />
                  <ListView fx:id="lvOutput">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </ListView>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </content>
      </Tab>
  </tabs>
</TabPane>
